{
  "name": "@tailsnconk/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-free discovery engine + cocktail domain logic. No React, no React Native.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./full": "./src/full.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "gen:meta": "tsx src/scripts/gen-meta.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.0"
  }
}
