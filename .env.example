# ============================================================================
# tailsnconk — environment variable TEMPLATE
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every value below is intentionally BLANK. All infrastructure is created
# FRESH for this project — do not paste keys from any other project.
#
#   cp .env.example .env
#
# Only EXPO_PUBLIC_* vars are inlined into the static web build (public, anon
# only). Everything else is server-side / CI and must never reach the client
# bundle (enforced by `npm run check:secrets`).
# ============================================================================


# ---------------------------------------------------------------------------
# CLIENT BUILD (public — inlined into the static site; anon-safe only)
# ---------------------------------------------------------------------------
# New Supabase project's URL and PUBLIC anon (publishable) key.
# If BOTH are empty the app runs against the on-device local backend (no server).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site origin, used for SEO/sitemap/JSON-LD (e.g. https://tailsnconk.com)
EXPO_PUBLIC_SITE_URL=

# Ad provider for the <AdSlot> component. Rendering is gated to web + production.
# EXPO_PUBLIC_AD_PROVIDER: which integration to use (e.g. "adsense"); blank = ads off.
# EXPO_PUBLIC_AD_CLIENT_ID: the provider's publisher/client id (e.g. ca-pub-XXXX).
EXPO_PUBLIC_AD_PROVIDER=
EXPO_PUBLIC_AD_CLIENT_ID=


# ---------------------------------------------------------------------------
# EDGE FUNCTIONS (server-side secrets — set via `supabase secrets set`)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (double opt-in newsletter) via Resend.
RESEND_API_KEY=
NEWSLETTER_FROM=
NEWSLETTER_POSTAL_ADDRESS=
# Shared secret guarding the scheduled broadcast function; fails closed if unset.
CRON_SECRET=

# Admin-triggered static rebuild (Cloudflare Pages deploy hook).
DEPLOY_HOOK_URL=
DEPLOY_HOOK_METHOD=
DEPLOY_HOOK_AUTHORIZATION=
DEPLOY_HOOK_BODY=


# ---------------------------------------------------------------------------
# CI / TOOLING (GitHub Actions secrets — content + pin pipelines only)
# ---------------------------------------------------------------------------
# Image generation provider: "fal" or "openai".
IMAGE_PROVIDER=
FAL_KEY=
FAL_MODEL=
FAL_VIDEO_MODEL=
FAL_VIDEO_DURATION=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
IMAGE_MAX_ATTEMPTS=

# Research/audit tooling (optional).
EXA_API_KEY=

# Cloudflare R2 (pin/asset hosting) + Pinterest pin tuning.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
PIN_PUBLIC_BASE=
PIN_PER_DAY=
PIN_START_DATE=
PIN_FILE_PREFIX=
PIN_SKIP=
