# ============================================================================
# Cloudflare Pages — _headers
# Files in apps/mobile/public/ are copied verbatim into the static export, so
# this ships as-is to Cloudflare Pages.
#
# AUTOMATIC AT BUILD — scripts/finalize-export.mjs rewrites the copy in dist/:
#   1. SUPABASE:  https://YOUR-PROJECT.supabase.co (and the wss: twin) are
#      replaced with the origin from EXPO_PUBLIC_SUPABASE_URL. The build FAILS if
#      that env is set but the placeholder can't be substituted. With no Supabase
#      env (local/PR builds) the placeholder is left as-is.
#   2. ADS:  when EXPO_PUBLIC_AD_PROVIDER=adsense, the AdSense hosts are added to
#      script-src / connect-src / frame-src automatically.
# You only need to hand-edit this file if you deploy dist/ without running the
# export's finalize step.
# ============================================================================

# ---- All routes: security + a locked-down CSP -----------------------------
/*
  # --- Content Security Policy ---
  # 'unsafe-inline' on script/style is required by the Expo web runtime (it
  # injects an inline bootstrap + inline styles). Everything else is allow-listed.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://YOUR-PROJECT.supabase.co wss://YOUR-PROJECT.supabase.co; frame-src 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests
  # --- Security headers ---
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# ---- Immutable, content-hashed build assets: cache hard --------------------
/_expo/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/pins/*
  Cache-Control: public, max-age=31536000, immutable

# ---- Static images / fonts shipped from public/: cache a while -------------
/images/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ---- Brand assets (favicon, app icons, share card, manifest): day cache -----
/fonts.css
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/og-default.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400

# ---- Crawl/config files: short cache so updates propagate fast -------------
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
